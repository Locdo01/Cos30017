<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF5E9">

    <!-- TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/btn_settings"
        android:textColor="#25215D"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- MUSIC TITLE -->
    <TextView
        android:id="@+id/musicText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/music_label"
        android:textColor="#25215D"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- SOUND SETTINGS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <Switch
            android:id="@+id/switchBgMusic"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingStart="4dp"
            android:text="@string/bg_music"
            android:textColor="#25215D"
            android:textSize="20sp"
            android:checked="true"
            android:thumbTint="#EF5A38"
            android:trackTint="#F4B4A1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E8E0F5" />

        <Switch
            android:id="@+id/switchSoundEffect"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingStart="4dp"
            android:text="@string/sound_effect"
            android:textColor="#25215D"
            android:textSize="20sp"
            android:checked="true"
            android:thumbTint="#EF5A38"
            android:trackTint="#F4B4A1" />

    </LinearLayout>

    <!-- LANGUAGE TITLE -->
    <TextView
        android:id="@+id/languageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/language_label"
        android:textColor="#25215D"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- LANGUAGE OPTIONS -->
    <RadioGroup
        android:id="@+id/languageRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/radioEnglish"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/language_en"
            android:textColor="#25215D"
            android:textSize="20sp"
            android:buttonTint="#EF5A38" />

        <RadioButton
            android:id="@+id/radioVietnamese"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/language_vi"
            android:textColor="#25215D"
            android:textSize="20sp"
            android:buttonTint="#EF5A38" />

    </RadioGroup>

    <!-- FLEXIBLE SPACE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_back"
        android:text="@string/btn_back"
        android:textColor="#25215D"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="@null" />

</LinearLayout>