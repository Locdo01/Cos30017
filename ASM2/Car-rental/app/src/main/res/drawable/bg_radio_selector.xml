<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A solid accent fill makes the active radio option easy to spot. -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/nav_selected" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_selected" />
            <size
                android:width="23dp"
                android:height="23dp" />
        </shape>
    </item>

    <!-- Unselected -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/app_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/app_border" />
            <size
                android:width="23dp"
                android:height="23dp" />
        </shape>
    </item>

</selector>
