<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CarRental" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nav_selected</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!-- Keep the Activity window background matched to the selected theme. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <!-- Avoid showing a stale or black Activity preview during a screen refresh. -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.CarRental" parent="Base.Theme.CarRental" />
</resources>
