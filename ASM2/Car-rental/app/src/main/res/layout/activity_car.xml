<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/app_background">

    <!-- Scrollable Home Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <!-- All Home Components -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search -->
            <include layout="@layout/fragment_search_layout" />

            <!-- Sort -->
            <include layout="@layout/fragment_sort_layout" />

            <!-- Brands -->
            <include layout="@layout/fragment_brand_layout" />

            <TextView
                android:id="@+id/tvListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:text="@string/all_cars_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvListTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/carListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include
                android:id="@+id/notFoundContainer"
                layout="@layout/fragment_not_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include layout="@layout/fragment_empty_favorites" />

        </LinearLayout>

    </ScrollView>

    <!-- Fixed Bottom Navigation -->
    <include
        layout="@layout/fragment_nav_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


</LinearLayout>
