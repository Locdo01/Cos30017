<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/app_background">

    <!-- Scrollable Home Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <!-- All Home Components -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search -->
            <include layout="@layout/fragment_search_layout" />

            <!-- Sort -->
            <include layout="@layout/fragment_sort_layout" />

            <!-- Brands -->
            <include layout="@layout/fragment_brand_layout" />

            <!-- Car Card -->
            <include layout="@layout/fragment_car_card"/>

        </LinearLayout>

    </ScrollView>

    <!-- Fixed Bottom Navigation -->
    <include
        layout="@layout/fragment_nav_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
